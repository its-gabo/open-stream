# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=open_stream
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/open_stream
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/open_stream_test

# API and web app
PORT=3001
WEB_ORIGIN=https://app.openstream.localhost
# VITE_API_URL=
# Where the web server reaches the API, e.g. for the embeddable player
# API_INTERNAL_URL=http://localhost:3001

# Auth (generate the secret with: openssl rand -hex 32)
AUTH_SECRET=replace-with-a-long-random-secret-of-32-chars-or-more
AUTH_SESSION_TTL_HOURS=168
AUTH_EMAIL_VERIFICATION_TTL_HOURS=24
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_COOKIE_NAME=openstream_session
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax

# Email (Mailpit: https://mailbox.openstream.localhost)
EMAIL_FROM=no-reply@openstream.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false

# Redis and outbox
REDIS_URL=redis://localhost:6379
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_CONCURRENCY=5
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETRY_DELAY_MS=30000
ORGANIZATION_SWEEP_INTERVAL_MS=60000

# Default object storage (RustFS console: https://storage.openstream.localhost)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=open-stream
OBJECT_STORAGE_ACCESS_KEY_ID=rustfsadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=rustfsadmin
OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Generate with: openssl rand -base64 32
STORAGE_ENCRYPTION_KEY=replace-with-32-random-bytes-in-base64
# Keep off in production
# STORAGE_ALLOW_PRIVATE_ENDPOINTS=false

# Video processing (needs ffmpeg and ffprobe on the worker host)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# ffmpeg or ffprobe is stopped after this long without progress
FFMPEG_STALL_TIMEOUT_MS=300000
# x264, videotoolbox or nvenc
VIDEO_ENCODER=x264
# ultrafast, superfast, veryfast, faster, fast or medium
VIDEO_X264_PRESET=veryfast
VIDEO_PROCESSING_CONCURRENCY=1
VIDEO_PROCESSING_MAX_ATTEMPTS=3
VIDEO_PROCESSING_RETRY_DELAY_MS=60000
# A run that stops renewing its claim for the stall timeout is taken for dead;
# the timeout must be at least twice the heartbeat interval
VIDEO_PROCESSING_HEARTBEAT_INTERVAL_MS=30000
VIDEO_PROCESSING_STALL_TIMEOUT_MS=300000
# VIDEO_PROCESSING_TEMP_DIR=/var/tmp/openstream

# Importing videos from a URL
VIDEO_IMPORT_CONCURRENCY=2
VIDEO_IMPORT_MAX_ATTEMPTS=3
VIDEO_IMPORT_RETRY_DELAY_MS=60000
# The whole download must finish within this long (3 hours)
VIDEO_IMPORT_TIMEOUT_MS=10800000
# Keep off in production
# VIDEO_IMPORT_ALLOW_PRIVATE_URLS=false

# Transcribing videos into captions with an organization's provider
TRANSCRIPTION_CONCURRENCY=2
TRANSCRIPTION_MAX_ATTEMPTS=3
TRANSCRIPTION_RETRY_DELAY_MS=60000
# A provider must answer one 10-minute chunk of audio within this long
TRANSCRIPTION_REQUEST_TIMEOUT_MS=600000
TRANSCRIPTION_HEARTBEAT_INTERVAL_MS=30000
TRANSCRIPTION_STALL_TIMEOUT_MS=900000
# Lets providers run on this machine or the private network, e.g. your own
# Whisper server; keep off in production unless that is where it runs
# TRANSCRIPTION_ALLOW_PRIVATE_ENDPOINTS=false

# Webhooks
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_RETRY_DELAY_MS=30000
WEBHOOK_DELIVERY_CONCURRENCY=10
# Keep off in production
# WEBHOOK_ALLOW_PRIVATE_URLS=false

# Logging: debug, info, warn, error or silent; pretty or json
LOG_LEVEL=info
# LOG_FORMAT=pretty
