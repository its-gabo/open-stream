# Postgres (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=open_stream

# API database connection (must match the Postgres values above)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/open_stream

# Database for `bun run test`; created and migrated automatically (default shown)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/open_stream_test

# API
PORT=3001

# Web app origin behind the Caddy reverse proxy (apps/reverse-proxy).
# Used for CORS, CSRF origin checks and links in emails.
WEB_ORIGIN=https://app.openstream.localhost

# Optional API base URL for the web app. Leave unset to call the API on the
# page's own origin, where the reverse proxy forwards /api/* to the API.
# VITE_API_URL=

# Auth (generate with: openssl rand -hex 32)
AUTH_SECRET=replace-with-a-long-random-secret-of-32-chars-or-more

# Auth sessions, tokens and cookie (defaults shown)
AUTH_SESSION_TTL_HOURS=168
AUTH_EMAIL_VERIFICATION_TTL_HOURS=24
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_COOKIE_NAME=openstream_session

# The proxy serves HTTPS, so cookies are Secure. Set to false only when
# running the apps directly on http://localhost without the proxy.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax

# Email delivery (Mailpit UI: https://mailbox.openstream.localhost)
EMAIL_FROM=no-reply@openstream.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false

# Redis (BullMQ queue behind the outbox)
REDIS_URL=redis://localhost:6379

# Outbox worker (defaults shown)
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_CONCURRENCY=5
OUTBOX_MAX_ATTEMPTS=10
# Base delay of the exponential retry backoff
OUTBOX_RETRY_DELAY_MS=30000
