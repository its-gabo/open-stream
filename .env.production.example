REGISTRY="ghcr.io/<registry>"
TAG=latest

WEB_ORIGIN="https://<your-domain>"

POSTGRES_PASSWORD=

# openssl rand -hex 32
AUTH_SECRET=
# openssl rand -base64 32; don't change it once in use
STORAGE_ENCRYPTION_KEY=

EMAIL_FROM="no-reply@<your-domain>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false

CHAPTER_GENERATION_REQUEST_TIMEOUT_MS=85000

LOG_LEVEL=info
