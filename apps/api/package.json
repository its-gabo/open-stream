{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "dev:worker": "bun --env-file=../../.env --watch src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "bun --env-file=../../.env run drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env run src/db/migrate.ts",
    "openapi:generate": "bun --env-file=../../.env run src/openapi/export-openapi-schema.ts && prettier --write src/openapi/api-schema.json",
    "test:e2e": "bun test e2e"
  },
  "dependencies": {
    "@hono/standard-validator": "0.4.0",
    "@standard-community/standard-json": "0.3.7",
    "@standard-community/standard-openapi": "0.2.11",
    "@workspace/email-templates": "workspace:*",
    "@workspace/shared": "workspace:*",
    "bullmq": "6.4.2",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "hono-openapi": "1.5.0",
    "ioredis": "5.11.1",
    "nodemailer": "10.2.1",
    "openapi-types": "12.1.3",
    "postgres": "3.4.9",
    "ts-pattern": "5.9.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/nodemailer": "8.0.2",
    "drizzle-kit": "0.31.11",
    "fishery": "2.4.0"
  }
}
