{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenStream API",
    "description": "HTTP API of the OpenStream video platform.",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "Auth",
      "description": "Accounts, sessions and passwords"
    }
  ],
  "components": {
    "schemas": {
      "AuthEmptySuccessResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/ApiEmptyData"
          }
        },
        "required": ["code", "message", "data"],
        "additionalProperties": false
      },
      "ApiEmptyData": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": ["code", "message", "reason"],
        "additionalProperties": false
      },
      "AuthSignUpBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "redirectTo": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "required": ["name", "email", "password"]
      },
      "AuthSignInSuccessResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "user": {
                "$ref": "#/components/schemas/AuthUser"
              }
            },
            "required": ["user"],
            "additionalProperties": false
          }
        },
        "required": ["code", "message", "data"],
        "additionalProperties": false
      },
      "AuthUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "name": {
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean"
          }
        },
        "required": ["id", "email", "name", "emailVerified"],
        "additionalProperties": false
      },
      "AuthSignInBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": ["email", "password"]
      },
      "AuthSessionSuccessResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/AuthSession"
          }
        },
        "required": ["code", "message", "data"],
        "additionalProperties": false
      },
      "AuthSession": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "authenticated": {
                "type": "boolean",
                "const": false
              }
            },
            "required": ["authenticated"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "authenticated": {
                "type": "boolean",
                "const": true
              },
              "user": {
                "$ref": "#/components/schemas/AuthUser"
              }
            },
            "required": ["authenticated", "user"],
            "additionalProperties": false
          }
        ]
      },
      "AuthForgotPasswordBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": ["email"]
      },
      "AuthResetPasswordBody": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": ["token", "password"]
      }
    }
  },
  "paths": {
    "/api/v1/auth/sign-up/email": {
      "post": {
        "operationId": "signUpWithEmail",
        "tags": ["Auth"],
        "summary": "Create an account and send the verification email",
        "responses": {
          "201": {
            "description": "Account created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthEmptySuccessResponse"
                }
              }
            }
          },
          "403": {
            "description": "Request did not come from the web app origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "An account with this email already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Request body or query is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthSignUpBody"
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/sign-in/email": {
      "post": {
        "operationId": "signInWithEmail",
        "tags": ["Auth"],
        "summary": "Sign in and set the session cookie",
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSignInSuccessResponse"
                }
              }
            }
          },
          "401": {
            "description": "Email or password is incorrect",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Email is not verified, or the request origin is not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Request body or query is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthSignInBody"
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/sign-out": {
      "post": {
        "operationId": "signOut",
        "tags": ["Auth"],
        "summary": "Revoke the current session and clear its cookie",
        "responses": {
          "200": {
            "description": "Signed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthEmptySuccessResponse"
                }
              }
            }
          },
          "403": {
            "description": "Request did not come from the web app origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "operationId": "getSession",
        "tags": ["Auth"],
        "summary": "Read the session of the current cookie",
        "responses": {
          "200": {
            "description": "Current session, or `authenticated: false`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionSuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/forgot-password": {
      "post": {
        "operationId": "requestPasswordReset",
        "tags": ["Auth"],
        "summary": "Send a password reset email if the account exists",
        "responses": {
          "200": {
            "description": "Reset requested (also for unknown emails)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthEmptySuccessResponse"
                }
              }
            }
          },
          "403": {
            "description": "Request did not come from the web app origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Request body or query is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthForgotPasswordBody"
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/reset-password": {
      "post": {
        "operationId": "resetPassword",
        "tags": ["Auth"],
        "summary": "Set a new password and revoke every session of the user",
        "responses": {
          "200": {
            "description": "Password reset",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthEmptySuccessResponse"
                }
              }
            }
          },
          "403": {
            "description": "Request did not come from the web app origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Reset link is invalid or expired, or the request is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthResetPasswordBody"
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/verify-email": {
      "get": {
        "operationId": "verifyEmail",
        "tags": ["Auth"],
        "summary": "Consume an email verification link",
        "responses": {
          "200": {
            "description": "Email verified",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthEmptySuccessResponse"
                }
              }
            }
          },
          "422": {
            "description": "Verification link is invalid or expired, or the request is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "token",
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "required": true
          }
        ]
      }
    }
  }
}
