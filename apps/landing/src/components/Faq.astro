---
const questions = [
  {
    question: "Do I need a GPU?",
    answer: "No. Videos are encoded on the CPU by default. If you have an Apple Silicon Mac or an NVIDIA GPU, you can switch to it for faster encoding.",
  },
  {
    question: "Where are my videos stored?",
    answer: "In the built-in storage, or in your own S3-compatible bucket. Each library can use a different one.",
  },
  {
    question: "Can I stop other sites from using my videos?",
    answer: "Yes. List the sites allowed to play a library and no other site can embed it. For stricter control, use signed links that expire.",
  },
  {
    question: "How are views counted?",
    answer: "A view counts once playback starts, and watch time is measured as people actually watch. Viewers are never identified.",
  },
  {
    question: "Can I upload from my own backend?",
    answer: "Yes. Create an API key with upload access and send files from your backend with the API.",
  },
  {
    question: "What does it cost?",
    answer: "Nothing. OpenStream is released under the MIT License. You pay only for the servers and storage you run it on.",
  },
]
---

<section class="faq container" id="faq">
  <div class="faq__head">
    <p class="eyebrow">FAQ</p>
    <h2 class="section-title" data-reveal="lines">Questions, answered</h2>
  </div>
  <div class="faq__list">
    {
      questions.map((item, index) => (
        <div class="faq__item" data-faq data-reveal="fade">
          <h3>
            <button
              type="button"
              aria-expanded="false"
              aria-controls={`faq-${index}`}
              id={`faq-q-${index}`}
            >
              <span>{item.question}</span>
              <span class="faq__icon" aria-hidden="true" />
            </button>
          </h3>
          <div class="faq__answer" id={`faq-${index}`} role="region" aria-labelledby={`faq-q-${index}`}>
            <div>
              <p>{item.answer}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: clamp(6rem, 12vw, 10rem);
  }

  .faq__head {
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }

  .faq__item {
    border-bottom: 1px solid var(--line);
  }

  .faq__item:first-child {
    border-top: 1px solid var(--line);
  }

  .faq h3 {
    font-size: inherit;
    letter-spacing: normal;
  }

  .faq button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
    padding: 1.6rem 0;
    border: 0;
    background: none;
    font-size: clamp(1.1rem, 1.8vw, 1.45rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    text-align: left;
    cursor: pointer;
  }

  .faq__icon {
    position: relative;
    flex: none;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition:
      transform 0.5s var(--ease-out),
      background-color 0.3s;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%);
  }

  .faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq button:hover .faq__icon {
    background: var(--surface-2);
  }

  .faq button[aria-expanded="true"] .faq__icon {
    transform: rotate(135deg);
  }

  .faq__answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.6s var(--ease-out);
  }

  .faq__answer > div {
    overflow: hidden;
  }

  .faq__answer p {
    max-width: 60ch;
    padding-bottom: 1.6rem;
    color: var(--fg-dim);
  }

  .faq__item.is-open .faq__answer {
    grid-template-rows: 1fr;
  }

  @media (max-width: 900px) {
    .faq {
      grid-template-columns: 1fr;
    }
  }
</style>
