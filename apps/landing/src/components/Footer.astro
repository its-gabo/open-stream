---
import { APP_URL, DOCS_URL, GITHUB_URL } from "../lib/links"
import Signet from "./Signet.astro"
---

<footer class="footer">
  <div class="container footer__cta">
    <h2 class="footer__title" data-reveal="lines">Own every second of your video</h2>
    <div class="footer__actions" data-reveal="fade">
      <a href={DOCS_URL} class="btn btn--solid" data-magnetic>Self-host it</a>
      <a href={GITHUB_URL} class="btn" data-magnetic>Star on GitHub</a>
    </div>
  </div>

  <div class="footer__wordmark" aria-hidden="true" data-wordmark>
    <Signet id="footer-signet" class="footer__signet" />
    <span>openstream</span>
  </div>

  <div class="container footer__bottom">
    <p>MIT License</p>
    <nav aria-label="Footer">
      <a href={GITHUB_URL}>GitHub</a>
      <a href={DOCS_URL}>Docs</a>
      <a href={APP_URL}>Open app</a>
      <a href="#top">Back to top ↑</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    padding-top: clamp(6rem, 12vw, 10rem);
    padding-bottom: 3rem;
    border-top: 1px solid var(--line);
    overflow: hidden;
  }

  .footer__cta {
    display: grid;
    justify-items: center;
    gap: 2.5rem;
    text-align: center;
  }

  .footer__title {
    max-width: 14ch;
    font-size: clamp(2.8rem, 8vw, 7.5rem);
    letter-spacing: -0.045em;
  }

  .footer__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .footer__wordmark {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2vw;
    margin-top: clamp(4rem, 10vw, 8rem);
    padding-inline: var(--gutter);
    font-size: clamp(3rem, 13vw, 14rem);
    font-weight: 500;
    line-height: 0.85;
    letter-spacing: -0.06em;
    color: var(--fg);
    white-space: nowrap;
  }

  .footer__wordmark :global(.char) {
    display: inline-block;
  }

  .footer__signet {
    flex: none;
    width: 0.9em;
    height: 0.9em;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .footer__bottom nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer__bottom a:hover {
    color: var(--fg);
  }
</style>
