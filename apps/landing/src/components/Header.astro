---
import { APP_URL, GITHUB_URL } from "../lib/links"

const links = [
  { href: "#how-it-works", label: "How it works" },
  { href: "#features", label: "Features" },
  { href: "#player", label: "Player" },
  { href: "#security", label: "Security" },
  { href: "#faq", label: "FAQ" },
]
---

<header class="header" data-header>
  <div class="header__inner">
    <a href="#top" class="header__logo" aria-label="OpenStream home">
      <img
        src="/media/openstream-logo-dark.png"
        alt="OpenStream"
        width="1084"
        height="420"
      />
    </a>
    <nav class="header__nav" aria-label="Main">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="header__actions">
      <a href={APP_URL} class="header__app">Open app</a>
      <a href={GITHUB_URL} class="btn btn--solid header__cta" data-magnetic>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
          ></path>
        </svg>
        <span>Star on GitHub</span>
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: 14px var(--gutter);
    transition: transform 0.6s var(--ease-out);
  }

  .header.is-hidden {
    transform: translateY(-110%);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: var(--max);
    margin-inline: auto;
    padding: 8px 8px 8px 20px;
    border: 1px solid transparent;
    border-radius: 999px;
    transition:
      background-color 0.4s,
      border-color 0.4s,
      backdrop-filter 0.4s;
  }

  .header.is-scrolled .header__inner {
    background: rgb(17 18 22 / 0.72);
    border-color: var(--line);
    backdrop-filter: blur(14px);
  }

  .header__logo img {
    height: 30px;
    width: auto;
  }

  .header__nav {
    display: flex;
    gap: 2rem;
    font-size: 0.95rem;
    color: var(--fg-dim);
  }

  .header__nav a,
  .header__app {
    position: relative;
    transition: color 0.3s;
  }

  .header__nav a::after,
  .header__app::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.5s var(--ease-out);
  }

  .header__nav a:hover,
  .header__app:hover {
    color: var(--fg);
  }

  .header__nav a:hover::after,
  .header__app:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .header__app {
    font-size: 0.95rem;
    color: var(--fg-dim);
  }

  .header__cta {
    height: 2.75rem;
    padding-inline: 1.1rem;
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .header__nav,
    .header__app {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .header__cta span {
      display: none;
    }

    .header__cta {
      width: 2.75rem;
      padding: 0;
    }
  }
</style>
