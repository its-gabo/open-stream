---
import { DOCS_URL, GITHUB_URL } from "../lib/links"
import Icon from "./Icon.astro"

// Figures and layout follow the real dashboard, drawn in HTML so it stays sharp at any size
const nav = [
  { icon: "layout-dashboard", label: "Dashboard", active: true },
  { icon: "library", label: "Libraries" },
  { icon: "database", label: "Storages" },
  { icon: "history", label: "Activity" },
  { icon: "settings", label: "Settings" },
] as const

const stats = [
  { label: "Views", count: 10000, format: "k" },
  { label: "Watch time", value: "678h 07m" },
  { label: "Average view", value: "4m 05s" },
  { label: "Average completion", count: 50, suffix: "%" },
]

const views = [
  310, 290, 335, 360, 300, 345, 390, 330, 300, 410, 370, 350, 440, 470, 360, 420,
  400, 380, 460, 560, 520, 450, 430, 410, 480, 500, 640, 600, 430, 470,
]
const peak = 700

const libraries = [
  { name: "Open Movies", views: "6.1K", share: 100 },
  { name: "Trailers", views: "2.4K", share: 40 },
  { name: "Product demos", views: "1.5K", share: 25 },
]
const videos = [
  { name: "Big Buck Bunny", views: "3.5K", share: 100 },
  { name: "Tears of Steel", views: "2.2K", share: 63 },
  { name: "Elephants Dream", views: "1.4K", share: 40 },
]
const qualities = ["Auto", "1080p", "720p", "480p", "360p"]
---

<section class="hero" id="top">
  <div class="container hero__head">
    <p class="eyebrow" data-reveal="hero">Self-hosted · MIT-licensed · Multi-tenant</p>
    <h1 class="hero__title" data-reveal="hero-title">
      Open-source video hosting and streaming
    </h1>
    <div class="hero__row">
      <p class="hero__lead" data-reveal="hero">
        Upload videos, transcode them to adaptive HLS and play them in an
        embeddable player on your own sites. Your buckets, your domains, your
        viewers.
      </p>
      <div class="hero__actions" data-reveal="hero">
        <a href={DOCS_URL} class="btn btn--solid" data-magnetic>Self-host it</a>
        <a href={GITHUB_URL} class="btn" data-magnetic>View on GitHub</a>
      </div>
    </div>
  </div>

  <div class="hero__stage" data-hero-stage data-reveal="hero-stage">
    <div class="mock" data-hero-window>
      <div class="mock__scale">
        <div class="mock__chrome" aria-hidden="true">
          <span></span><span></span><span></span>
          <p>app.openstream.localhost</p>
        </div>

        <div class="app" role="img" aria-label="The OpenStream dashboard with views, watch time and views per day for the last 30 days">
          <aside class="app__sidebar">
            <img class="app__logo" src="/media/openstream-logo-light.png" alt="" width="1084" height="420" />
            <p class="app__group">Main menu</p>
            <ul class="app__nav">
              {
                nav.map((item) => (
                  <li class:list={{ "is-active": "active" in item }}>
                    <Icon name={item.icon} />
                    {item.label}
                  </li>
                ))
              }
            </ul>
            <div class="app__org">
              <span class="app__org-icon"><Icon name="building" /></span>
              <span>
                <strong>Aurora Pictures</strong>
                <small>/aurora-pictures</small>
              </span>
              <Icon name="chevrons-up-down" />
            </div>
          </aside>

          <div class="app__main">
            <header class="app__top">
              <Icon name="panel-left" class="app__toggle" />
              <strong>Dashboard</strong>
              <span class="app__top-right">
                <span><Icon name="inbox" /> Inbox</span>
                <span><span class="app__avatar">M</span> Maya Chen</span>
              </span>
            </header>

            <div class="app__content">
              <div class="card">
                <div class="card__head">
                  <span class="card__icon"><Icon name="chart-column" /></span>
                  <div>
                    <strong>Analytics</strong>
                    <p>Views of every library's embedded videos together. Open a library for its own figures.</p>
                  </div>
                  <div class="segmented">
                    <span>7 days</span><span class="is-active">30 days</span><span>90 days</span>
                  </div>
                </div>

                <div class="stats">
                  {
                    stats.map((stat) => (
                      <div class="stat">
                        <span>{stat.label}</span>
                        {stat.count !== undefined ? (
                          <strong data-mock-count={stat.count} data-format={stat.format} data-suffix={stat.suffix}>
                            {stat.format === "k" ? `${stat.count / 1000}K` : `${stat.count}${stat.suffix ?? ""}`}
                          </strong>
                        ) : (
                          <strong>{stat.value}</strong>
                        )}
                      </div>
                    ))
                  }
                </div>

                <div class="chart">
                  <strong>Views per day</strong>
                  <div class="chart__plot">
                    <div class="chart__axis"><span>700</span><span>350</span><span>0</span></div>
                    <div class="chart__bars">
                      {views.map((value) => <span style={`--h: ${(value / peak) * 100}%`} data-mock-bar />)}
                    </div>
                  </div>
                  <div class="chart__dates"><span>Oct 20</span><span>Oct 27</span><span>Nov 3</span><span>Nov 10</span><span>Nov 17</span></div>
                </div>

                <div class="lists">
                  {
                    [
                      { title: "Top libraries", rows: libraries },
                      { title: "Top videos", rows: videos },
                    ].map((list) => (
                      <div class="list">
                        <strong>{list.title}</strong>
                        {list.rows.map((row) => (
                          <div class="list__row">
                            <span>{row.name}</span>
                            <span>{row.views} views</span>
                            <span class="list__bar"><span style={`--w: ${row.share}%`} data-mock-share /></span>
                          </div>
                        ))}
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="player" data-hero-player data-speed="0.8">
      <video
        src="/media/bbb.mp4"
        poster="/media/bbb-poster.jpg"
        width="1280"
        height="720"
        autoplay
        muted
        loop
        playsinline
        aria-label="Big Buck Bunny playing in the OpenStream player"
        data-hero-video></video>
      <div class="player__menu" data-player-menu aria-hidden="true">
        <span class="player__menu-title">Quality</span>
        {
          qualities.map((quality) => (
            <span class:list={{ "is-active": quality === "1080p" }}>
              {quality}
              {quality === "1080p" && <Icon name="check" />}
            </span>
          ))
        }
      </div>
      <div class="player__controls" aria-hidden="true">
        <div class="player__track">
          <span class="player__buffer" data-player-buffer></span>
          <span class="player__played" data-player-played></span>
        </div>
        <div class="player__row">
          <Icon name="play" class="is-filled" />
          <Icon name="volume-2" />
          <span class="player__time"><span data-player-time>3:20</span> / 10:34</span>
          <span class="player__spacer"></span>
          <span class="player__badge">1080p</span>
          <Icon name="settings" />
          <Icon name="picture-in-picture-2" />
          <Icon name="maximize" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(130px, 18vh, 200px);
  }

  .hero__title {
    max-width: 14ch;
    margin-top: 1.5rem;
    font-size: clamp(3rem, 9.4vw, 9.25rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  .hero__row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }

  .hero__lead {
    max-width: 34rem;
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    color: var(--fg-dim);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__stage {
    position: relative;
    max-width: calc(var(--max) + 2 * var(--gutter));
    margin: clamp(3rem, 7vw, 6rem) auto 0;
    padding-inline: var(--gutter);
    padding-bottom: clamp(2rem, 8vw, 7rem);
    perspective: 1400px;
  }

  /* The mockup is laid out in em, and 1em is 1/80 of its width, so it scales like an image */
  .mock {
    container-type: inline-size;
    width: 92%;
    border: 1px solid var(--line-strong);
    border-radius: 20px;
    overflow: hidden;
    background: #fff;
    box-shadow:
      0 50px 140px -30px rgb(0 0 0 / 0.85),
      0 0 0 1px rgb(255 255 255 / 0.02) inset;
    transform-origin: 50% 0;
    will-change: transform;
  }

  .mock__scale {
    font-size: calc(100cqw / 80);
    color: #0a0a0a;
    line-height: 1.4;
  }

  .mock__chrome {
    display: flex;
    align-items: center;
    gap: 0.45em;
    height: 2.6em;
    padding-inline: 1em;
    background: var(--bg-raised);
    border-bottom: 1px solid var(--line);
  }

  .mock__chrome span {
    width: 0.7em;
    height: 0.7em;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .mock__chrome p {
    margin-left: 0.9em;
    font-size: 0.82em;
    color: var(--muted);
  }

  .app {
    display: grid;
    grid-template-columns: 14em 1fr;
    height: 44em;
    overflow: hidden;
  }

  .app :global(svg) {
    flex: none;
    width: 1em;
    height: 1em;
  }

  .app__sidebar {
    display: flex;
    flex-direction: column;
    padding: 1.1em 0.75em;
    background: #fafafa;
    border-right: 1px solid #ececec;
  }

  .app__logo {
    width: 5.6em;
    height: auto;
    margin: 0.1em 0.5em 1.6em;
  }

  .app__group {
    margin: 0 0.5em 0.5em;
    font-size: 0.75em;
    color: #737373;
  }

  .app__nav {
    display: grid;
    gap: 0.15em;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875em;
  }

  .app__nav li {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.5em 0.6em;
    border-radius: 0.5em;
    color: #262626;
  }

  .app__nav li.is-active {
    background: #efefef;
    font-weight: 500;
  }

  .app__org {
    display: flex;
    align-items: center;
    gap: 0.6em;
    margin-top: auto;
    padding: 0.5em;
    font-size: 0.8em;
  }

  .app__org > span:nth-child(2) {
    display: grid;
    flex: 1;
    line-height: 1.25;
  }

  .app__org small {
    font-family: var(--font-mono);
    font-size: 0.8em;
    color: #737373;
  }

  .app__org-icon {
    display: grid;
    place-items: center;
    width: 2em;
    height: 2em;
    border-radius: 0.45em;
    background: #171717;
    color: #fff;
  }

  .app__main {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: #fbfbfb;
  }

  .app__top {
    display: flex;
    align-items: center;
    gap: 0.9em;
    height: 3.2em;
    padding-inline: 1.1em;
    border-bottom: 1px solid #ececec;
    background: #fff;
    font-size: 0.875em;
  }

  .app__toggle {
    color: #525252;
    padding-right: 0.9em;
    box-sizing: content-box;
    border-right: 1px solid #ececec;
  }

  .app__top-right {
    display: flex;
    gap: 1.2em;
    margin-left: auto;
    font-weight: 500;
  }

  .app__top-right > span {
    display: flex;
    align-items: center;
    gap: 0.4em;
  }

  .app__avatar {
    display: grid;
    place-items: center;
    width: 1.3em;
    height: 1.3em;
    border-radius: 50%;
    background: #171717;
    color: #fff;
    font-size: 0.75em;
  }

  .app__content {
    padding: 1.6em 1.8em;
  }

  .card {
    display: grid;
    gap: 1.1em;
    padding: 1.2em;
    border: 1px solid #ececec;
    border-radius: 0.9em;
    background: #fff;
  }

  .card__head {
    display: flex;
    align-items: center;
    gap: 0.8em;
    padding-bottom: 1em;
    border-bottom: 1px solid #f0f0f0;
  }

  .card__head strong {
    font-size: 1em;
    font-weight: 500;
  }

  .card__head p {
    font-size: 0.8em;
    color: #737373;
  }

  .card__icon {
    display: grid;
    place-items: center;
    width: 2.3em;
    height: 2.3em;
    border-radius: 0.55em;
    background: #f4f4f4;
    color: #404040;
  }

  .segmented {
    display: flex;
    margin-left: auto;
    padding: 0.2em;
    border-radius: 0.55em;
    background: #f4f4f4;
    font-size: 0.78em;
    color: #737373;
    white-space: nowrap;
  }

  .segmented span {
    padding: 0.3em 0.6em;
    border-radius: 0.4em;
  }

  .segmented .is-active {
    background: #fff;
    color: #0a0a0a;
    font-weight: 500;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75em;
  }

  .stat {
    display: grid;
    gap: 0.2em;
    padding: 0.85em 1em;
    border: 1px solid #ececec;
    border-radius: 0.7em;
  }

  .stat span {
    font-size: 0.78em;
    color: #737373;
  }

  .stat strong {
    font-size: 1.45em;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .chart {
    display: grid;
    gap: 0.7em;
    padding: 1em;
    border: 1px solid #ececec;
    border-radius: 0.7em;
  }

  .chart > strong {
    font-size: 0.85em;
    font-weight: 500;
  }

  .chart__plot {
    display: grid;
    grid-template-columns: 2em 1fr;
    height: 11.5em;
  }

  .chart__axis {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-size: 0.68em;
    color: #8a8a8a;
  }

  .chart__bars {
    display: flex;
    align-items: flex-end;
    gap: 0.35em;
    background: repeating-linear-gradient(
      to bottom,
      #f1f1f1 0 1px,
      transparent 1px 50%
    );
    border-bottom: 1px solid #e5e5e5;
  }

  .chart__bars span {
    flex: 1;
    height: var(--h);
    border-radius: 0.25em 0.25em 0 0;
    background: #737373;
    transform-origin: bottom;
  }

  .chart__bars span:nth-last-child(-n + 1) {
    background: #171717;
  }

  .chart__dates {
    display: flex;
    justify-content: space-between;
    padding-left: 2.6em;
    font-size: 0.68em;
    color: #8a8a8a;
  }

  .lists {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75em;
  }

  .list {
    display: grid;
    gap: 0.6em;
    padding: 1em;
    border: 1px solid #ececec;
    border-radius: 0.7em;
  }

  .list > strong {
    font-size: 0.85em;
    font-weight: 500;
  }

  .list__row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.35em;
    font-size: 0.8em;
  }

  .list__row span:nth-child(2) {
    font-weight: 600;
  }

  .list__bar {
    grid-column: 1 / -1;
    height: 0.3em;
    border-radius: 1em;
    background: #f1f1f1;
  }

  .list__bar span {
    display: block;
    width: var(--w);
    height: 100%;
    border-radius: inherit;
    background: #737373;
    transform-origin: left;
  }

  /* The live player, floating over the dashboard like in the product banner */
  .player {
    position: absolute;
    right: var(--gutter);
    bottom: 0;
    width: min(48%, 600px);
    container-type: inline-size;
    border: 1px solid var(--line-strong);
    border-radius: 16px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 40px 100px -20px rgb(0 0 0 / 0.9);
  }

  .player video {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .player__controls {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: 2.4cqw;
    padding: 8cqw 3.2cqw 2.6cqw;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.7));
    color: #fff;
    font-size: max(10px, 2.6cqw);
  }

  .player__track {
    position: relative;
    height: 0.8cqw;
    min-height: 3px;
    border-radius: 1em;
    background: rgb(255 255 255 / 0.28);
    overflow: hidden;
  }

  .player__buffer,
  .player__played {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    transform-origin: left;
    transform: scaleX(0.32);
  }

  .player__buffer {
    background: rgb(255 255 255 / 0.4);
    transform: scaleX(0.46);
  }

  .player__played {
    background: #fff;
  }

  .player__row {
    display: flex;
    align-items: center;
    gap: 1.1em;
  }

  .player__row :global(svg) {
    width: 1.5em;
    height: 1.5em;
  }

  .player__row :global(.is-filled) {
    fill: currentColor;
  }

  .player__time {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .player__spacer {
    flex: 1;
  }

  .player__badge {
    padding: 0.1em 0.45em;
    border-radius: 0.35em;
    background: rgb(255 255 255 / 0.18);
    font-size: 0.8em;
    font-weight: 600;
  }

  .player__menu {
    position: absolute;
    right: 9cqw;
    bottom: 15cqw;
    display: grid;
    min-width: 9.5em;
    padding: 0.45em;
    border-radius: 0.8em;
    background: rgb(20 21 25 / 0.88);
    backdrop-filter: blur(12px);
    color: #fff;
    font-size: max(10px, 2.4cqw);
    transform-origin: 100% 100%;
    opacity: 0;
    visibility: hidden;
  }

  .player__menu span {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.35em 0.6em;
    border-radius: 0.45em;
  }

  .player__menu .is-active {
    background: rgb(255 255 255 / 0.12);
  }

  .player__menu-title {
    color: rgb(255 255 255 / 0.55);
    font-size: 0.85em;
  }

  .player__menu :global(svg) {
    width: 1em;
    height: 1em;
  }

  @media (max-width: 760px) {
    .mock {
      border-radius: 12px;
    }

    .player {
      width: 62%;
      border-radius: 10px;
    }

    .player__menu,
    .player__row :global(svg:not(.is-filled)) {
      display: none;
    }
  }
</style>
