---
import { icons, type IconName } from "../lib/icons"

interface Props {
  name: IconName
  class?: string
}

const { name, class: className, ...rest } = Astro.props
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  {...rest}
  set:html={icons[name]}
/>
