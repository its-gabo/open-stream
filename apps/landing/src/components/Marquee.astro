---
import Signet from "./Signet.astro"

const words = ["Upload", "Transcode", "Caption", "Play", "Engage", "Measure", "Integrate"]
const rows = [
  { id: "a", direction: -1 },
  { id: "b", direction: 1 },
]
---

<section class="marquee" aria-label="Upload, transcode, caption, play, engage, measure, integrate">
  {
    rows.map((row) => (
      <div class="marquee__row" data-marquee={row.direction} aria-hidden="true">
        {[0, 1].map((copy) => (
          <div class="marquee__track">
            {words.map((word, index) => (
              <span class="marquee__item">
                <span class={row.direction < 0 ? "" : "is-outline"}>{word}</span>
                <Signet id={`mq-${row.id}-${copy}-${index}`} class="marquee__signet" />
              </span>
            ))}
          </div>
        ))}
      </div>
    ))
  }
</section>

<style>
  .marquee {
    display: grid;
    gap: 0.5rem;
    padding-block: clamp(5rem, 12vw, 10rem);
    overflow: hidden;
  }

  .marquee__row {
    display: flex;
    width: max-content;
  }

  .marquee__track {
    display: flex;
    flex: none;
  }

  .marquee__item {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding-right: clamp(1.25rem, 3vw, 2.5rem);
    font-family: var(--font-heading);
    font-size: clamp(3rem, 9vw, 8.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: lowercase;
  }

  .is-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--fg-dim);
  }

  .marquee__signet {
    width: 0.55em;
    height: 0.55em;
    color: var(--muted);
  }
</style>
