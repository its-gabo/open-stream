---
const bars = [42, 38, 41, 41, 36, 44, 47, 37, 33, 47, 42, 40, 52, 53, 37, 45, 43, 41, 52, 64, 59, 50, 48, 44, 52, 52, 72, 66, 44, 50]
const cue = "Big Buck Bunny wakes up to a beautiful morning".split(" ")
const chapters = [
  { time: "0:00", title: "A quiet morning" },
  { time: "1:52", title: "Three troublemakers" },
  { time: "4:37", title: "Setting the traps" },
  { time: "7:48", title: "Payback" },
]
const sites = [
  { host: "aurora-pictures.test", allowed: true },
  { host: "blog.aurora-pictures.test", allowed: true },
  { host: "someone-else.example", allowed: false },
]
---

<section class="pipeline" id="how-it-works" data-pipeline>
  <div class="pipeline__sticky">
    <div class="container pipeline__head">
      <div>
        <p class="eyebrow">How it works</p>
        <h2 class="section-title pipeline__title" data-reveal="lines">From upload to analytics</h2>
      </div>
      <p class="pipeline__counter" aria-hidden="true">
        <span class="pipeline__counter-current"><span data-pipeline-current>01</span></span>
        <span class="pipeline__counter-total">/ 05</span>
      </p>
    </div>

    <ol class="pipeline__track" data-pipeline-track>
      <li class="panel" data-panel>
        <div class="panel__copy">
          <span class="panel__index">01</span>
          <h3>Upload</h3>
          <p>
            Drop in an MP4 or MOV of up to 20 GiB, or paste a link and the
            server downloads it. Uploads are resumable, so a dropped connection
            picks up where it left off.
          </p>
        </div>
        <div class="panel__visual upload">
          <div class="upload__file">
            <span class="upload__icon">MOV</span>
            <div>
              <strong>launch-film.mov</strong>
              <span>4.2 GiB · <span data-upload-percent>0</span>%</span>
            </div>
          </div>
          <div class="upload__chunks">
            {Array.from({ length: 40 }, () => <span data-chunk></span>)}
          </div>
          <p class="panel__caption">Resumable upload · import from a URL</p>
        </div>
      </li>

      <li class="panel" data-panel>
        <div class="panel__copy">
          <span class="panel__index">02</span>
          <h3>Transcode</h3>
          <p>
            Every video becomes adaptive HLS in the qualities you pick, with a
            poster and seek previews. Runs on any CPU, or faster on a GPU.
          </p>
        </div>
        <div class="panel__visual ladder">
          {
            [
              ["1080p", "5.0 Mbps", 100],
              ["720p", "2.8 Mbps", 72],
              ["480p", "1.4 Mbps", 48],
              ["360p", "0.8 Mbps", 32],
            ].map(([label, rate, width]) => (
              <div class="ladder__row">
                <span class="ladder__label">{label}</span>
                <span class="ladder__bar" style={`--w: ${width}%`}>
                  <span data-ladder-fill />
                </span>
                <span class="ladder__rate">{rate}</span>
              </div>
            ))
          }
          <div class="ladder__storyboard">
            {Array.from({ length: 8 }, (_, index) => (
              <span data-frame style={`background-position: ${(index / 7) * 100}% 0`} />
            ))}
          </div>
          <p class="panel__caption">Adaptive HLS · poster · seek previews</p>
        </div>
      </li>

      <li class="panel" data-panel>
        <div class="panel__copy">
          <span class="panel__index">03</span>
          <h3>Enrich</h3>
          <p>
            Upload captions, or have your AI provider transcribe the video. Then
            let it suggest chapters from the captions, and review them before
            you save.
          </p>
        </div>
        <div class="panel__visual enrich">
          <div class="enrich__screen">
            <img src="/media/bbb-poster.jpg" alt="" width="1280" height="720" loading="lazy" />
            <p class="enrich__cue">
              {cue.map((word) => <span data-cue-word>{word} </span>)}
            </p>
          </div>
          <ol class="enrich__chapters">
            {
              chapters.map((chapter) => (
                <li data-chapter>
                  <span>{chapter.time}</span>
                  {chapter.title}
                </li>
              ))
            }
          </ol>
          <p class="panel__caption">Captions · chapters suggested from them</p>
        </div>
      </li>

      <li class="panel" data-panel>
        <div class="panel__copy">
          <span class="panel__index">04</span>
          <h3>Play</h3>
          <p>
            Paste one embed code for a video or a whole playlist. Only the sites
            you allow can play your videos, and signed links can make them expire.
          </p>
        </div>
        <div class="panel__visual player">
          <div class="player__screen">
            <img src="/media/bbb-poster.jpg" alt="" width="1280" height="720" loading="lazy" />
            <div class="player__controls">
              <span class="player__progress"><span data-player-progress></span></span>
              <span class="player__time">3:20 / 10:34</span>
            </div>
          </div>
          <ul class="player__sites">
            {
              sites.map((site) => (
                <li class={site.allowed ? "is-allowed" : "is-blocked"} data-site>
                  <span>{site.host}</span>
                  <span>{site.allowed ? "allowed" : "refused"}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </li>

      <li class="panel" data-panel>
        <div class="panel__copy">
          <span class="panel__index">05</span>
          <h3>Measure</h3>
          <p>
            See views, watch time and retention for every video, how far viewers
            get through each chapter, and who answers your calls to action.
          </p>
        </div>
        <div class="panel__visual chart">
          <div class="chart__stats">
            <div><span>Views</span><strong data-count="7200" data-format="k">0</strong></div>
            <div><span>Average view</span><strong>5m 28s</strong></div>
            <div><span>Completion</span><strong data-count="51" data-suffix="%">0</strong></div>
          </div>
          <div class="chart__bars">
            {bars.map((value) => <span style={`--h: ${value}%`} data-bar />)}
          </div>
          <p class="panel__caption">Views per day · last 30 days</p>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .pipeline {
    position: relative;
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .pipeline__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .pipeline__title {
    max-width: 12ch;
    margin-top: 1.25rem;
    font-size: clamp(2.4rem, 5vw, 4.4rem);
  }

  .pipeline__counter {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-variant-numeric: tabular-nums;
  }

  .pipeline__counter-current {
    display: inline-block;
    overflow: hidden;
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 1;
  }

  .pipeline__counter-current span {
    display: inline-block;
  }

  .pipeline__counter-total {
    font-size: 1.25rem;
    color: var(--muted);
  }

  .pipeline__track {
    display: flex;
    gap: clamp(1rem, 2vw, 1.5rem);
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0 var(--gutter);
    list-style: none;
  }

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    flex: none;
    width: min(1080px, 82vw);
    min-height: min(52vh, 480px);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: 24px;
    background: linear-gradient(160deg, var(--surface) 0%, var(--bg-raised) 70%);
  }

  .panel__copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .panel__index {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .panel h3 {
    margin-top: auto;
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    letter-spacing: -0.02em;
  }

  .panel p {
    color: var(--fg-dim);
  }

  .panel a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .panel__visual {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    padding: clamp(1rem, 2vw, 1.5rem);
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--bg);
  }

  .panel__caption {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted) !important;
  }

  /* Upload */
  .upload__file {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .upload__file div {
    display: grid;
  }

  .upload__file div span {
    font-size: 0.85rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .upload__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 52px;
    border-radius: 8px;
    background: var(--fg);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .upload__chunks {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 6px;
  }

  .upload__chunks span {
    aspect-ratio: 1;
    border-radius: 5px;
    background: var(--surface-2);
  }

  .upload__chunks span.is-done {
    background: var(--fg);
    transition: background-color 0.2s;
  }

  /* Transcode */
  .ladder__row {
    display: grid;
    grid-template-columns: 3.5rem 1fr 4.5rem;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .ladder__rate {
    color: var(--muted);
    text-align: right;
  }

  .ladder__bar {
    width: var(--w);
    height: 26px;
    border-radius: 6px;
    background: var(--surface-2);
    overflow: hidden;
  }

  .ladder__bar span {
    display: block;
    height: 100%;
    background: var(--fg);
    transform-origin: left;
  }

  .ladder__storyboard {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 4px;
    margin-top: 0.5rem;
  }

  .ladder__storyboard span {
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    background-image: url("/media/bbb-storyboard.jpg");
    background-size: 800% 100%;
  }

  /* Enrich */
  .enrich__screen {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
  }

  .enrich__screen img {
    width: 100%;
    height: auto;
  }

  .enrich__cue {
    position: absolute;
    inset: auto 8% 0.9rem;
    margin: 0 auto;
    width: fit-content;
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
    background: rgb(0 0 0 / 0.72);
    color: #fff !important;
    font-size: clamp(0.7rem, 1.1vw, 0.85rem);
    text-align: center;
  }

  .enrich__chapters {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
  }

  .enrich__chapters li {
    display: flex;
    gap: 0.9rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .enrich__chapters span {
    min-width: 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  /* Play */
  .player__screen {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
  }

  .player__screen img {
    width: 100%;
    height: auto;
  }

  .player__controls {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 2rem 0.9rem 0.75rem;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.75));
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .player__progress {
    flex: 1;
    height: 4px;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.3);
    overflow: hidden;
  }

  .player__progress span {
    display: block;
    height: 100%;
    background: #fff;
    transform-origin: left;
    transform: scaleX(0.32);
  }

  .player__sites {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .player__sites li {
    display: flex;
    justify-content: space-between;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .player__sites li span:last-child {
    color: var(--muted);
  }

  .player__sites .is-blocked {
    color: var(--muted);
    text-decoration: line-through;
    text-decoration-color: var(--line-strong);
  }

  /* Measure */
  .chart__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }

  .chart__stats div {
    display: grid;
    gap: 0.2rem;
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: 10px;
  }

  .chart__stats span {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .chart__stats strong {
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-variant-numeric: tabular-nums;
  }

  .chart__bars {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 150px;
  }

  .chart__bars span {
    flex: 1;
    height: var(--h);
    border-radius: 3px 3px 0 0;
    background: var(--fg-dim);
    transform-origin: bottom;
  }

  @media (min-width: 901px) {
    .pipeline__sticky {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 100vh;
    }

    .pipeline__track {
      width: max-content;
    }
  }

  @media (max-width: 900px) {
    .pipeline__counter {
      display: none;
    }

    .pipeline__track {
      flex-direction: column;
    }

    .panel {
      width: 100%;
      grid-template-columns: 1fr;
    }
  }
</style>
