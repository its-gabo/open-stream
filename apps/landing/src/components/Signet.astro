---
import type { HTMLAttributes } from "astro/types"

interface Props extends HTMLAttributes<"svg"> {
  id: string
  label?: string
}

// The rest carries the parent's scoped style attribute
const { id, class: className, label, ...rest } = Astro.props
const maskId = `${id}-cut`
---

<svg
  class={className}
  viewBox="0 0 200 200"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  data-signet
  {...rest}
>
  <defs>
    <mask id={maskId} maskUnits="userSpaceOnUse" x="0" y="0" width="200" height="200">
      <rect width="200" height="200" fill="#fff"></rect>
      <g fill="#000" stroke="#000" stroke-width="14" stroke-linejoin="round">
        <path d="M100 20 A40 40 0 0 0 100 100 Z"></path>
        <path d="M100 100 A40 40 0 0 1 100 180 Z"></path>
      </g>
    </mask>
  </defs>
  <rect
    data-signet-ring
    x="64"
    y="29"
    width="72"
    height="142"
    rx="36"
    fill="none"
    stroke="currentColor"
    stroke-width="18"
    pathLength="100"
    mask={`url(#${maskId})`}></rect>
  <g fill="currentColor">
    <path data-signet-top d="M100 20 A40 40 0 0 0 100 100 Z"></path>
    <path data-signet-bottom d="M100 100 A40 40 0 0 1 100 180 Z"></path>
  </g>
</svg>
