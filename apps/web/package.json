{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "generate:client": "swagger-typescript-api generate -p ../api/src/openapi/api-schema.json -o ./src/api --name generated-api.ts --api-class-name OpenStreamApi --module-name-first-tag --unwrap-response-data --extract-request-params --sort-types --enum-style=union && prettier --write src/api/generated-api.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.0",
    "@tailwindcss/vite": "4",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@workspace/shared": "workspace:*",
    "@workspace/ui": "workspace:*",
    "i18next": "26.5.10",
    "i18next-browser-languagedetector": "8.2.2",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-i18next": "17.1.8",
    "sonner": "2.0.8",
    "tailwindcss": "4",
    "ts-pattern": "5.9.2",
    "zod": "4.6.7",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "1.167.45",
    "@types/node": "22",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "6",
    "eslint": "10",
    "swagger-typescript-api": "13.13.0",
    "typescript": "6.0.2",
    "vite": "8"
  }
}
