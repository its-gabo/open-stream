{
  "name": "open-stream",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo run dev dev:worker",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "generate:api": "turbo run build --filter=@workspace/shared --filter=@workspace/email-templates && bun run --cwd apps/api openapi:generate && bun run --cwd apps/web generate:client"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.10",
    "typescript": "6.0.2"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
