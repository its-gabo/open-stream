{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": [
        "^lint",
        "@workspace/shared#build",
        "@workspace/email-templates#build"
      ]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck",
        "@workspace/shared#build",
        "@workspace/email-templates#build"
      ]
    },
    "test": {
      "cache": false,
      "dependsOn": [
        "@workspace/shared#build",
        "@workspace/email-templates#build"
      ]
    },
    "test:coverage": {
      "cache": false,
      "dependsOn": [
        "@workspace/shared#build",
        "@workspace/email-templates#build"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "@workspace/shared#build",
        "@workspace/email-templates#build"
      ]
    },
    "dev:worker": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "@workspace/shared#build",
        "@workspace/email-templates#build"
      ]
    },
    "@workspace/shared#build": {
      "outputs": ["dist/**"]
    },
    "@workspace/email-templates#build": {
      "outputs": ["dist/**"]
    }
  }
}
